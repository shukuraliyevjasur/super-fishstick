// ManyChat Alternative — B2B Instagram Comment → DM SaaS schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // scrypt-derived, in the self-describing format written by lib/auth/password.ts.
  // Null means the account predates passwords (or was created by a magic link and
  // has not set one yet) — those users are sent to /set-password after signing in.
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  telegramLink      TelegramLink?
  telegramLinkCodes TelegramLinkCode[]
  ownedWorkspaces   Workspace[]       @relation("WorkspaceOwner")
  workspaceMembers  WorkspaceMember[]
  sentInvitations   WorkspaceInvitation[] @relation("WorkspaceInvitationsSent")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Workspace {
  id        String        @id @default(cuid())
  name      String
  ownerId   String
  owner     User          @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  plan              WorkspacePlan @default(FREE)
  usagePeriodStart  DateTime      @default(now())
  dmsSentThisPeriod Int           @default(0)

  // Billing audit trail. Written only by grantWorkspacePlan() in
  // lib/billing/grant.ts — the admin route and, later, the payment webhook both
  // go through that one function. See D2 in DECISIONS.md.
  //
  // planGrantedBy is an actor string, not a foreign key: it holds a user id for
  // a manual grant and something like "webhook:click" for an automated one, and
  // an audit row must survive the actor's account being deleted.
  planGrantedAt     DateTime?
  planGrantedBy     String?
  // Null means "does not expire". Enforced by getEffectivePlan(), so a lapsed
  // plan stops working the moment it expires rather than when a cron notices.
  planExpiresAt     DateTime?

  members                WorkspaceMember[]
  invitations            WorkspaceInvitation[]
  instagramAccounts      InstagramAccount[]
  automations            Automation[]
  dmLogs                 DmLog[]
  trackedLinks           TrackedLink[]
  linkClicks             LinkClick[]
  webhookEvents          WebhookEvent[]
  operationalEvents      OperationalEvent[]
  telegramFlows          TelegramFlow[]
  telegramConversations  TelegramConversation[]

  @@index([ownerId])
  @@index([planExpiresAt])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(OWNER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvitation {
  id              String                    @id @default(cuid())
  workspaceId     String
  email           String
  role            WorkspaceRole             @default(MEMBER)
  token           String                    @unique
  status          WorkspaceInvitationStatus @default(PENDING)
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("WorkspaceInvitationsSent", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([email])
  @@index([workspaceId])
  @@index([status])
}

model InstagramAccount {
  id                String   @id @default(cuid())
  workspaceId       String
  instagramId       String   @unique
  username          String
  name              String?
  accessToken       String
  tokenExpiresAt    DateTime?
  webhookSubscribed Boolean  @default(false)
  connectedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automations Automation[]
  dmLogs      DmLog[]
  linkClicks  LinkClick[]

  @@index([workspaceId])
}

model Automation {
  id                 String   @id @default(cuid())
  workspaceId        String
  instagramAccountId String

  name           String
  goal           String?
  postId         String?
  postUrl        String?
  pendingNextReel Boolean @default(false)
  matchAnyPost   Boolean @default(false)
  keywords       String[]
  matchAnyWord   Boolean @default(false)
  dmMessage      String
  openingDmEnabled     Boolean @default(false)
  openingDmMessage     String?
  openingDmButtonLabel String?
  linkButtonLabel      String?
  requireFollow           Boolean @default(false)
  followPromptMessage     String?
  followPromptButtonLabel String?
  publicReplyEnabled Boolean @default(false)
  publicReplyMessage String?
  publicReplyMessages String[] @default([])
  // T10: opt-in Telegram destination. Off by default and invisible to every
  // customer who does not use Telegram (D4 of the CEO review). telegramFlowId
  // is the flow picker D8 calls for — when set it replaces the placeholder
  // "workspace's most recent active flow" rule recorded in D9.
  telegramEnabled Boolean @default(false)
  telegramFlowId  String?
  isActive       Boolean @default(true)
  wholeWordMatch Boolean @default(true)
  reportShareSlug    String? @unique
  reportShareEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  // SetNull, not Cascade: deleting a flow must not delete the campaigns that
  // pointed at it. The campaign falls back to having no Telegram destination.
  telegramFlow     TelegramFlow?    @relation(fields: [telegramFlowId], references: [id], onDelete: SetNull)
  dmLogs           DmLog[]
  trackedLinks     TrackedLink[]
  linkClicks       LinkClick[]

  @@index([workspaceId])
  @@index([instagramAccountId])
  @@index([postId])
  @@index([telegramFlowId])
}

model DmLog {
  id                 String     @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String

  commenterId   String
  commenterName String?
  commentText   String
  commentId     String
  matchedKeyword String?
  status        DmStatus @default(PENDING)
  attempts      Int      @default(0)
  dmSentAt      DateTime?
  errorMessage  String?

  // The public comment reply is delivered independently of the DM, so its
  // outcome is tracked separately. publicReplySentAt makes it idempotent across
  // retries; a DM failure never blocks or re-posts the public reply.
  publicReplySentAt DateTime?
  publicReplyError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([automationId, commentId])
  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  @@index([status])
}

// Every comment the system has seen, from either the webhook or the polling
// reconciler. This is the shared dedup set: a comment id present here has
// already been queued for processing, so neither path acts on it twice. It is
// distinct from DmLog (which only records comments that matched a campaign);
// this records all comments so the reconciler doesn't re-sweep non-matching
// ones every cycle.
model ProcessedComment {
  id                 String   @id @default(cuid())
  instagramAccountId String
  commentId          String   @unique
  source             String // "WEBHOOK" | "POLLING"
  seenAt             DateTime @default(now())

  @@index([instagramAccountId])
}

model TrackedLink {
  id             String   @id @default(cuid())
  workspaceId    String
  automationId   String
  slug           String   @unique
  label          String?
  destinationUrl String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation Automation  @relation(fields: [automationId], references: [id], onDelete: Cascade)
  clicks     LinkClick[]

  @@index([workspaceId])
  @@index([automationId])
}

model LinkClick {
  id                 String   @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String
  trackedLinkId      String
  ipHash             String?
  userAgent          String?
  referrer           String?
  createdAt          DateTime @default(now())

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  trackedLink      TrackedLink      @relation(fields: [trackedLinkId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  @@index([trackedLinkId])
  @@index([createdAt])
  @@index([workspaceId, createdAt])
}

model WebhookEvent {
  id          String        @id @default(cuid())
  workspaceId String?
  object      String?
  payload     Json
  status      WebhookStatus @default(PENDING)
  errorMessage String?
  createdAt   DateTime      @default(now())
  processedAt DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([status])
}

model OperationalEvent {
  id          String                @id @default(cuid())
  workspaceId String?
  source      OperationalEventSource
  level       OperationalEventLevel @default(INFO)
  message     String
  payload     Json?
  createdAt   DateTime              @default(now())
  resolvedAt  DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([source])
  @@index([level])
  @@index([createdAt])
}

// Top-level flow definition. Steps are a JSON tree — the editor reads and
// writes the whole tree at once. Separate from Automation (Issue 4 in
// roadmap.md): Automation is Instagram-shaped and already ~30 fields.
/// D4: binds a builder's own Telegram account to their replie user, so a test
/// send has somewhere to go. One Telegram account per user — re-linking
/// replaces the binding rather than accumulating rows.
model TelegramLink {
  id             String   @id @default(cuid())
  userId         String   @unique
  telegramUserId BigInt
  chatId         BigInt
  linkedAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Short-lived one-time code carried in a /start payload. Opaque and stored
/// rather than signed: Telegram caps the payload at 64 characters, which an
/// HMAC token does not fit, and a stored code can be revoked.
model TelegramLinkCode {
  code      String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model TelegramFlow {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  steps       Json     @default("[]")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace     Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations TelegramConversation[]
  automations   Automation[]

  @@index([workspaceId])
}

// Per-user conversation state, keyed on (telegramUserId, workspaceId) per D5.
// lastActiveAt drives the TTL sweep (E9) folded into the existing health cron.
model TelegramConversation {
  id              String   @id @default(cuid())
  telegramUserId  BigInt
  workspaceId     String
  flowId          String
  currentStepId   String?
  answers         Json     @default("{}")
  lastActiveAt    DateTime @default(now())
  createdAt       DateTime @default(now())

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  flow      TelegramFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([telegramUserId, workspaceId])
  @@index([workspaceId])
  @@index([flowId])
  @@index([lastActiveAt])
}

enum WorkspacePlan {
  FREE
  STANDART
  PRO
  AGENCY
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum DmStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_DEDUP
  SKIPPED_RATE_LIMIT
  SKIPPED_PLAN_LIMIT
  SKIPPED_NO_MATCH
}

enum WebhookStatus {
  PENDING
  PROCESSED
  FAILED
}

enum OperationalEventSource {
  WORKER
  TOKEN_REFRESH
  HEALTH
  SYSTEM
}

enum OperationalEventLevel {
  INFO
  WARNING
  ERROR
}
